#!/usr/bin/env bash
# Pre-commit hook: SPDX copyright headers + AACS VUK leak guard.
set -euo pipefail

# SPDX copyright headers on staged .rs files.
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs' | grep -v '^tests/assets/' || true)
[ -n "$files" ] && .githooks/check-copyright.sh $files

# AACS VUK leak guard on all staged files.
.githooks/check-vuks.sh
